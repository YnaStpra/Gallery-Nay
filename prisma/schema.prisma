generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Photo {
  id                 String    @id @default(cuid())
  title              String
  slug               String?
  description        String?
  shootingConditions String?
  shootingChallenges String?
  waitingTime        String?
  interestingFacts    String?
  behindTheShot      String?
  imageUrl           String
  originalImageUrl   String?
  cloudinaryPublicId String?
  originalPublicId   String?
  blurDataUrl        String?
  altText            String?
  location           String?
  country            String?
  latitude           Float?
  longitude          Float?
  collection         String?
  collectionId       String?    @map("collection_id")
  collectionRelation Collection? @relation("CollectionPhotos", fields: [collectionId], references: [id])
  takenAt            DateTime?
  camera             String?
  lens               String?
  focalLength        String?
  aperture           String?
  shutterSpeed       String?
  iso                Int?
  width              Int?
  height             Int?
  originalWidth      Int?
  originalHeight     Int?
  originalFileSize   Int?
  originalFileType   String?
  fileType           String?
  colorProfile       String?
  dominantColor      String?
  copyright          String?
  isDownloadable     Boolean   @default(false)
  lutUrl             String?
  lutFileName        String?
  lutFormat          String?
  lutFileSize        Int?
  lutName            String?
  lutVersion         String?
  lutDescription     String?
  editingSoftware    String?
  cameraProfile      String?
  photographerNotes  String?
  allowDownload      Boolean   @default(false)
  isPremium          Boolean   @default(false)
  uploadedAt         DateTime?
  published          Boolean   @default(true)
  viewCount          Int       @default(0)
  favoriteCount      Int       @default(0)
  requestCount       Int       @default(0)
  isPrintReady       Boolean   @default(false)
  printAvailableSizes Json?
  printAspectRatios  Json?
  tags               String[]  @default([])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  downloadRequests   DownloadRequest[] @relation("PhotoDownloadRequests")
  photoOfTheDay      PhotoOfTheDay?
}

model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  photos      Photo[]  @relation("CollectionPhotos")
}

model Story {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  coverImage  String
  content     Json
  location    String?
  country     String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Gear {
  id           String   @id @default(cuid())
  name         String
  type         String
  description  String?
  image        String
  purchaseDate DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DownloadRequest {
  id           String                 @id @default(cuid())
  name         String
  email        String
  reason       String
  usagePurpose String
  message      String?
  photoId      String
  photo        Photo                  @relation("PhotoDownloadRequests", fields: [photoId], references: [id], onDelete: Cascade)
  requestType  DownloadRequestType    @default(ORIGINAL)
  status       DownloadRequestStatus  @default(PENDING)
  requestedAt  DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model PhotoOfTheDay {
  id        String   @id @default(cuid())
  photoId   String   @unique
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  selectedAt DateTime @default(now())
  createdAt DateTime @default(now())
}

enum DownloadRequestType {
  ORIGINAL
  HIGH_RES
  COMMERCIAL_LICENSE
  EDITORIAL_USAGE
}

enum DownloadRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}
