generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Photo {
  id                 String    @id @default(cuid())
  title              String
  slug               String?
  description        String?
  imageUrl           String
  cloudinaryPublicId String?
  blurDataUrl        String?
  altText            String?
  location           String?
  country            String?
  latitude           Float?
  longitude          Float?
  collection         String?
  collectionId       String?    @map("collection_id")
  collectionRelation Collection? @relation("CollectionPhotos", fields: [collectionId], references: [id])
  takenAt            DateTime?
  camera             String?
  lens               String?
  focalLength        String?
  aperture           String?
  shutterSpeed       String?
  iso                Int?
  width              Int?
  height             Int?
  fileType           String?
  colorProfile       String?
  dominantColor      String?
  copyright          String?
  isDownloadable     Boolean   @default(false)
  published          Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  downloadRequests   DownloadRequest[] @relation("PhotoDownloadRequests")
}

model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  photos      Photo[]  @relation("CollectionPhotos")
}

model Story {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  coverImage  String
  content     Json
  location    String?
  country     String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Gear {
  id           String   @id @default(cuid())
  name         String
  type         String
  description  String?
  image        String
  purchaseDate DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DownloadRequest {
  id           String                 @id @default(cuid())
  name         String
  email        String
  reason       String
  usagePurpose String
  photoId      String
  photo        Photo                  @relation("PhotoDownloadRequests", fields: [photoId], references: [id])
  status       DownloadRequestStatus  @default(PENDING)
  requestedAt  DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

enum DownloadRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}
